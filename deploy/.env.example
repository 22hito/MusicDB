# Скопіюйте в deploy/.env і заповніть. Файл .env у git не потрапляє.
# Домен, що вказує (A-запис) на IP сервера, напр. nowl.duckdns.org або ваш власний.
DOMAIN=nowl.abrdns.com
# openssl rand -base64 36
POSTGRES_PASSWORD=
# openssl rand -base64 48
AUTH_SECRET=
# Google OAuth: у Google Console додати redirect URI https://<DOMAIN>/v1/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAILS=dima1post1@gmail.com
# Cloudflare R2 (той самий бакет nowl, що й у v1)
S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
S3_BUCKET=nowl
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
# Ключі YouTube Data API через кому
YOUTUBE_API_KEYS=
