{
  "name": "musicdb-frontend-tooling",
  "private": true,
  "description": "Lint/format tooling for wwwroot/*.js — no runtime dependency, not shipped to the site.",
  "scripts": {
    "lint": "eslint wwwroot/js wwwroot/sw.js",
    "format": "prettier --write wwwroot/js wwwroot/sw.js",
    "format:check": "prettier --check wwwroot/js wwwroot/sw.js"
  },
  "devDependencies": {
    "eslint": "^9.15.0",
    "globals": "^15.12.0",
    "prettier": "^3.3.3"
  }
}
