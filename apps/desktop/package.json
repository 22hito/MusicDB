{
  "name": "@musicdb/desktop",
  "version": "2.0.0",
  "private": true,
  "description": "N'Owl для Windows",
  "author": "N'Owl",
  "type": "module",
  "main": "out/main.cjs",
  "scripts": {
    "dev": "node scripts/build.mjs --dev && electron .",
    "build": "node scripts/build.mjs",
    "dist": "node scripts/build.mjs && electron-builder --win --publish never",
    "release": "node scripts/build.mjs && electron-builder --win --publish always",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/playfair-display": "^5.2.8",
    "@musicdb/config": "workspace:*",
    "@musicdb/contracts": "workspace:*",
    "@musicdb/i18n": "workspace:*",
    "@musicdb/player": "workspace:*",
    "@musicdb/sdk": "workspace:*",
    "@musicdb/tokens": "workspace:*",
    "@musicdb/web": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "better-auth": "1.7.7",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-updater": "6.8.9",
    "esbuild": "^0.27.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-router": "^8.4.0",
    "tailwindcss": "4.3.3",
    "vite": "^8.3.2"
  },
  "build": {
    "appId": "com.nowl.desktop",
    "productName": "N'Owl",
    "copyright": "N'Owl",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "out/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asar": true,
    "publish": {
      "provider": "github",
      "owner": "22hito",
      "repo": "MusicDB"
    },
    "protocols": [
      {
        "name": "N'Owl",
        "schemes": [
          "nowl"
        ]
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "NOwl-Setup.${ext}"
    },
    "portable": {
      "artifactName": "NOwl-Portable.${ext}"
    }
  }
}
