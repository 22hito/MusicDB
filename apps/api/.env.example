# Публічна адреса, за якою клієнти бачать API (/v1). У розробці — адреса сайту, що проксує /v1.
API_URL=http://localhost:3000
WEB_ORIGINS=http://localhost:3000
PORT=8787
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/musicdb
AUTO_MIGRATE=true
# openssl rand -base64 48
AUTH_SECRET=change-me-change-me-change-me-change-me
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAILS=
# local | s3 (Cloudflare R2: S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com)
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
# Ключі YouTube Data API через кому — пошук відео для треків каталогу
YOUTUBE_API_KEYS=
# Або файл із ключами: JSON { "YouTube": { "ApiKeys": [...] } } чи ключ на рядок.
YOUTUBE_API_KEYS_FILE=
WORKER_MODE=inline
LOG_LEVEL=info
