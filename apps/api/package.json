{
  "name": "@musicdb/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --env-file-if-exists=.env src/server.ts",
    "create-user": "tsx --env-file-if-exists=.env scripts/create-user.ts",
    "start": "node dist/server.js",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:start": "pnpm --filter @musicdb/db dev-db",
    "db:migrate": "pnpm --filter @musicdb/db migrate",
    "openapi": "tsx scripts/openapi.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@better-auth/expo": "1.7.7",
    "@hono/node-server": "2.1.3",
    "@hono/node-ws": "^1.3.1",
    "@musicdb/contracts": "workspace:*",
    "@musicdb/db": "workspace:*",
    "@scalar/hono-api-reference": "^0.12.9",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.3",
    "ffmpeg-static": "5.3.0",
    "fractional-indexing": "4.0.0",
    "hono": "4.13.13",
    "pino": "10.4.0",
    "zod": "4.6.5",
    "zod-openapi": "6.0.2"
  },
  "devDependencies": {
    "@musicdb/config": "workspace:*",
    "@types/node": "^24.19.1",
    "pino-pretty": "^13.1.3",
    "tsup": "8.5.1",
    "tsx": "^4.23.15",
    "vitest": "5.0.3"
  }
}
