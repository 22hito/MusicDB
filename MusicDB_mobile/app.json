{
  "expo": {
    "name": "N'Owl",
    "slug": "musicdb-mobile",
    "version": "1.1.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "musicdb",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Дозвіл потрібен, щоб обрати зображення для аватарки профілю."
      }
    },
    "android": {
      "package": "com.nowl.mobile",
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#090c14",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "usesCleartextTraffic": true,
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Дозвіл потрібен, щоб обрати зображення для аватарки профілю."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#090c14",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-image",
      "expo-web-browser",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6649fc84-6592-4735-926f-1fccdf1e3769"
      }
    },
    "owner": "22hito",
    "updates": {
      "url": "https://u.expo.dev/6649fc84-6592-4735-926f-1fccdf1e3769"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
